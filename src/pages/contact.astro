---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Form from "@/components/form/Form.astro";
import Input from "@/components/form/Input.astro";
import Textarea from "@/components/form/Textarea.astro";
import {
  CONTACT_EMAIL,
  CONTACT_PHONE,
  CONTACT_PHONE_HREF,
  EMAIL_DRAFT_MESSAGE,
} from "@/consts";
import Select from "@/components/form/Select.astro";
import Card from "@/components/item/Card.astro";
import ContactExchange from "@/components/content/ContactExchange.astro";
---

<Layout
  title="Contact OPSA"
  description="Contact Dr. Zameer Pirani for OPSA membership, partnerships, media or general inquiries."
>
  <!-- Hero -->
  <Section theme="dark">
    <ContentWrapper variant="columns-wide">
      <Eyebrow>Contact OPSA</Eyebrow>
      <Heading tag="h1" class="heading-accent" maxWidth={20}>
        Better care starts
        <br />
        <strong>with a conversation.</strong>
      </Heading>
      <Paragraph variant="large" maxWidth={57}>
        Get in touch about membership, collaboration or OPSA’s work to advance
        specialist-led pain care in Ontario.
      </Paragraph>
      <ButtonWrapper>
        <Button element="link" href="#message" variant="directional">
          Send a message
        </Button>
      </ButtonWrapper>
      <ContactExchange slot="column2" />
    </ContentWrapper>
  </Section>
  <!-- Contacts -->
  <Section>
    <Grid large={3}>
      {[
        {
          heading: "General inquiries",
          text: "Questions about OPSA or getting involved.",
        },
        {
          heading: "Government and partners",
          text: "Connect about advocacy, collaboration and health system priorities.",
        },
        {
          heading: "Media",
          text: "Contact OPSA about interviews, commentary and media inquiries.",
        },
      ].map((item) => (
        <Card
          heading={item.heading}
          headingTag="h2"
          text={item.text}
        >
          <Paragraph slot="footer">
            Dr. Zameer Pirani<br />
            <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a><br />
            <a href={CONTACT_PHONE_HREF}>{CONTACT_PHONE}</a>
          </Paragraph>
        </Card>
      ))}
    </Grid>
  </Section>
  <!-- Message form -->
  <Section id="message" class="background-2">
    <ContentWrapper variant="sticky-content">
      <Eyebrow>Get in touch</Eyebrow>
      <Heading>How can we help?</Heading>
      <Paragraph>
        OPSA is an advocacy association, not a clinic or referral service. For
        questions about your own care, contact your treating clinician. Please
        do not send personal medical information.
      </Paragraph>
      <Form
        slot="column2"
        name="OPSA contact message"
        action={`mailto:${CONTACT_EMAIL}`}
        successMessage={EMAIL_DRAFT_MESSAGE}
        aria-label="Contact OPSA"
      >
        <Grid medium={2}>
          <Input
            label="Full name"
            name="name"
            autocomplete="name"
            required
            maxlength={120}
          />
          <Input
            label="Email"
            variant="email"
            name="email"
            required
            maxlength={254}
          />
        </Grid>
        <Select
          label="Topic"
          name="topic"
          options={[
            "General inquiry",
            "Membership",
            "Government and partnerships",
            "Media",
          ]}
          required
        />
        <Textarea
          label="Your message"
          name="message"
          required
          maxlength={2000}
          minLines={5}
        />
        <Button type="submit">Continue in email</Button>
        <Paragraph variant="small">
          Submitting opens a draft in your email app. Review it and press Send
          to complete your request. If it does not open, email{" "}
          <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> directly.
        </Paragraph>
      </Form>
    </ContentWrapper>
  </Section>
</Layout>
