---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Form from "@/components/form/Form.astro";
import Input from "@/components/form/Input.astro";
import Textarea from "@/components/form/Textarea.astro";
import {
  CONTACT_EMAIL,
  CONTACT_PHONE,
  CONTACT_PHONE_HREF,
  EMAIL_DRAFT_MESSAGE,
} from "@/consts";
import Card from "@/components/item/Card.astro";
import KnowledgeShare from "@/components/content/KnowledgeShare.astro";
---

<Layout
  title="Presentations"
  description="Request a conversation with OPSA about specialist-led pain care, patient experience and advocacy in Ontario."
>
  <!-- Hero -->
  <Section theme="dark">
    <ContentWrapper variant="columns">
      <Eyebrow>Presentations</Eyebrow>
      <Heading tag="h1" class="heading-accent" maxWidth={22}>
        A shared understanding
        <br />
        <strong>of pain care.</strong>
      </Heading>
      <Paragraph variant="large" maxWidth={58}>
        Bring pain care into the conversation at your organization, practice or
        community group.
      </Paragraph>
      <ButtonWrapper>
        <Button element="link" href="#request" variant="directional">
          Request a presentation
        </Button>
      </ButtonWrapper>
      <KnowledgeShare slot="column2" />
    </ContentWrapper>
  </Section>
  <!-- Topics -->
  <Section>
    <ContentWrapper>
      <Eyebrow>Start a conversation</Eyebrow>
      <Heading maxWidth={23}>Care, experience and a shared purpose.</Heading>
      <Paragraph maxWidth={64}>
        Tell us about your audience and the topics you would like to explore. We
        will follow up to discuss format, timing and availability.
      </Paragraph>
    </ContentWrapper>
    <Grid large={3}>
      <Card
        variant="feature"
        symbol="target"
        heading="Specialist-led pain care"
        text="OPSA’s position on image guidance, appropriate training and holistic care."
      />
      <Card
        variant="feature"
        symbol="voice"
        heading="Patient and caregiver voices"
        text="The place of lived experience in conversations about pain care."
      />
      <Card
        variant="feature"
        symbol="foundation"
        heading="Building OPSA"
        text="Our mission, advocacy priorities and opportunities to get involved."
      />
    </Grid>
    <Paragraph>
      OPSA’s presentation library is taking shape. There are no presentations
      available to download yet.
    </Paragraph>
  </Section>
  <!-- Request form -->
  <Section id="request" class="background-2">
    <ContentWrapper variant="sticky-content">
      <Eyebrow>Let’s talk</Eyebrow>
      <Heading>Request a presentation.</Heading>
      <Paragraph>
        Questions first? Email{" "}
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> or call{" "}
        <a href={CONTACT_PHONE_HREF}>{CONTACT_PHONE}</a>.
      </Paragraph>
      <Form
        slot="column2"
        name="OPSA presentation request"
        action={`mailto:${CONTACT_EMAIL}`}
        successMessage={EMAIL_DRAFT_MESSAGE}
        aria-label="Request a presentation"
      >
        <Grid medium={2}>
          <Input
            label="Full name"
            name="name"
            autocomplete="name"
            required
            maxlength={120}
          />
          <Input
            label="Email"
            variant="email"
            name="email"
            required
            maxlength={254}
          />
        </Grid>
        <Input
          label="Organization"
          name="organization"
          autocomplete="organization"
          required
          maxlength={160}
        />
        <Input
          label="Audience"
          name="audience"
          required
          maxlength={200}
          placeholder="Who will be attending?"
        />
        <Input
          label="Preferred date or timeframe (optional)"
          name="timeframe"
          maxlength={120}
        />
        <Textarea
          label="Topics and event details"
          name="details"
          required
          maxlength={2000}
          placeholder="Topics, format, location and anything else we should know."
        />
        <Button type="submit">Continue in email</Button>
        <Paragraph variant="small">
          Submitting opens a draft in your email app. Review it and press Send
          to complete your request. If it does not open, email{" "}
          <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> directly.
        </Paragraph>
      </Form>
    </ContentWrapper>
  </Section>
</Layout>
