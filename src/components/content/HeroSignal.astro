---
import type { HTMLAttributes } from "astro/types";
interface Props extends HTMLAttributes<"figure"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
}
const { render = true, class: className, ...rest } = Astro.props;
const groups = [
  {
    label: "Pain specialists",
    x: 260,
    y: 40,
    labelX: 184,
    labelY: 58,
    width: 152,
    textX: 260,
    rotation: -210,
  },
  {
    label: "Patients & caregivers",
    x: 86.795,
    y: 340,
    labelX: 9,
    labelY: 364,
    width: 184,
    textX: 101,
    rotation: 30,
  },
  {
    label: "Community partners",
    x: 433.205,
    y: 340,
    labelX: 345,
    labelY: 364,
    width: 166,
    textX: 428,
    rotation: -90,
  },
];
---

{render && (
  <figure class:list={["hero-signal_wrap", className]} {...rest}>
    <svg
      class="hero-signal_visual"
      viewBox="0 0 520 490"
      fill="none"
      role="group"
      aria-label="Explore the people connected through OPSA"
    >
      <circle class="hero-signal_orbit" cx="260" cy="240" r="200" />
      <circle
        class="hero-signal_ring"
        cx="260"
        cy="240"
        r="200"
        pathLength="100"
        stroke-dasharray="100 100"
        transform="rotate(-90 260 240)"
      />
      <circle class="hero-signal_orbit" cx="260" cy="240" r="153" />
      <circle
        class="hero-signal_arc"
        cx="260"
        cy="240"
        r="200"
        pathLength="100"
        stroke-dasharray="33.333333 66.666667"
        aria-hidden="true"
      />
      <circle class="hero-signal_inner" cx="260" cy="240" r="99" />
      <path
        class="hero-signal_connection"
        d="M260 141V40M174 290l-87 50M346 290l87 50"
      />
      <circle class="hero-signal_core" cx="260" cy="199" r="6" />
      <text class="hero-signal_title" x="260" y="239" text-anchor="middle">
        People at
      </text>
      <text class="hero-signal_title" x="260" y="269" text-anchor="middle">
        the centre.
      </text>
      {groups.map((group) => (
        <g
          class="hero-signal_target"
          role="button"
          tabindex="0"
          aria-label={group.label}
          aria-pressed="false"
          data-rotation={group.rotation}
        >
          <circle class="hero-signal_hit" cx={group.x} cy={group.y} r="24" />
          <circle class="hero-signal_halo" cx={group.x} cy={group.y} r="14" />
          <circle class="hero-signal_node" cx={group.x} cy={group.y} r="7" />
          <rect
            class="hero-signal_label-surface"
            x={group.labelX}
            y={group.labelY}
            width={group.width}
            height="40"
            rx="20"
          />
          <text
            class="hero-signal_label"
            x={group.textX}
            y={group.labelY + 26}
            text-anchor="middle"
          >
            {group.label}
          </text>
        </g>
      ))}
    </svg>
    <figcaption class="hero-signal_caption text-style-small">
      Pain specialists, patients and community partners.
      <br />
      One connected voice for Ontario.
    </figcaption>
  </figure>
)}
<script>
  for (const figure of document.querySelectorAll<HTMLElement>(
    ".hero-signal_wrap",
  )) {
    const arc = figure.querySelector<SVGCircleElement>(".hero-signal_arc");
    const targets = [
      ...figure.querySelectorAll<SVGGElement>(".hero-signal_target"),
    ];
    if (!arc) continue;
    const hover = window.matchMedia("(hover: hover) and (pointer: fine)");
    let hovered: SVGGElement | null = null;
    let focused: SVGGElement | null = null;
    let selected: SVGGElement | null = null;
    let rotation = -210;

    const update = (keyboard = false) => {
      const active = hovered || focused || selected;
      figure.toggleAttribute("data-keyboard", keyboard);
      figure.toggleAttribute("data-active", !!active);
      targets.forEach((target) =>
        target.setAttribute("aria-pressed", String(target === active)),
      );
      if (!active) return;
      figure.setAttribute("data-interacted", "");
      const destination = Number(active.dataset.rotation);
      rotation += ((((destination - rotation + 540) % 360) + 360) % 360) - 180;
      arc.style.transform = `rotate(${rotation}deg)`;
    };

    for (const target of targets) {
      target.addEventListener("pointerenter", () => {
        if (!hover.matches) return;
        hovered = target;
        update();
      });
      target.addEventListener("pointerleave", () => {
        hovered = null;
        update();
      });
      target.addEventListener("focus", () => {
        if (!target.matches(":focus-visible")) return;
        focused = target;
        update(true);
      });
      target.addEventListener("blur", () => {
        focused = null;
        update(true);
      });
      target.addEventListener("click", (event) => {
        if (hover.matches && event.detail !== 0) return;
        selected = selected === target ? null : target;
        update(event.detail === 0);
      });
      target.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          selected = selected === target ? null : target;
          focused = selected;
          update(true);
        }
        if (event.key === "Escape") {
          hovered = focused = selected = null;
          update(true);
        }
      });
    }
  }
</script>

<style is:global>
  @layer components {
    .hero-signal_wrap {
      --_signal-duration: var(--illustration-duration);
      width: min(100%, var(--illustration-max-width));
      align-self: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      color: var(--heading-accent);
      @media (prefers-reduced-motion: no-preference) {
        & .hero-signal_ring {
          animation: care-connect var(--_signal-duration) var(--hover-ease) both;
        }
        & .hero-signal_arc {
          transition:
            transform var(--_signal-duration) var(--hover-ease),
            opacity var(--_signal-duration) var(--hover-ease);
        }
        & .hero-signal_ring,
        & .hero-signal_halo {
          transition: opacity var(--_signal-duration) var(--hover-ease);
        }
      }
      &[data-interacted] .hero-signal_ring {
        animation: none;
      }
      &[data-keyboard] .hero-signal_arc {
        transition: none;
      }
      &[data-active] {
        & .hero-signal_ring {
          opacity: 0.3;
        }
        & .hero-signal_arc {
          opacity: 1;
        }
      }
    }
    @keyframes care-connect {
      from {
        stroke-dashoffset: 100;
      }
      to {
        stroke-dashoffset: 0;
      }
    }
    .hero-signal_visual {
      width: 100%;
      aspect-ratio: 520 / 490;
      overflow: visible;
    }
    .hero-signal_orbit {
      stroke: currentColor;
      stroke-opacity: 0.22;
      stroke-width: 1;
    }
    .hero-signal_ring,
    .hero-signal_arc {
      stroke: currentColor;
      stroke-width: 2;
    }
    .hero-signal_arc {
      transform-origin: 50% 48.979592%;
      transform: rotate(-210deg);
      opacity: 0;
      pointer-events: none;
    }
    .hero-signal_target {
      cursor: pointer;
      outline: none;
      &[aria-pressed="true"] {
        & .hero-signal_halo {
          opacity: 0.6;
        }
        & .hero-signal_label-surface {
          fill: currentColor;
        }
        & .hero-signal_label {
          fill: var(--background);
        }
      }
      &:focus-visible .hero-signal_label-surface {
        stroke: var(--text);
        stroke-width: 2;
      }
    }
    .hero-signal_hit {
      fill: transparent;
    }
    .hero-signal_halo {
      stroke: currentColor;
      stroke-width: 2;
      opacity: 0;
    }
    .hero-signal_inner {
      fill: var(--background-2);
      stroke: var(--border);
      stroke-width: 1;
    }
    .hero-signal_connection {
      stroke: currentColor;
      stroke-opacity: 0.4;
      stroke-width: 1;
    }
    .hero-signal_core {
      fill: var(--accent-care);
    }
    .hero-signal_node {
      fill: currentColor;
      stroke: var(--background);
      stroke-width: 3;
    }
    .hero-signal_title {
      fill: var(--text);
      font-family: var(--heading-family);
      font-size: var(--illustration-title-size);
    }
    .hero-signal_label-surface {
      fill: var(--background-2);
    }
    .hero-signal_label {
      fill: var(--text);
      font-family: var(--primary-family);
      font-size: var(--illustration-label-size);
    }
    .hero-signal_caption {
      color: var(--text-2);
      text-align: center;
    }
  }
</style>
