---
import type { HTMLAttributes } from "astro/types";
import Form from "@/components/form/Form.astro";
import Input from "@/components/form/Input.astro";
import Select from "@/components/form/Select.astro";
import Textarea from "@/components/form/Textarea.astro";
import Choice from "@/components/form/Choice.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import Grid from "@/components/wrapper/Grid.astro";
import {
  MEMBERSHIP_ENDPOINT,
  CONTACT_EMAIL,
  EMAIL_DRAFT_MESSAGE,
} from "@/consts.ts";
interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
}
const { render = true, class: className, ...rest } = Astro.props;
const action =
  MEMBERSHIP_ENDPOINT ||
  (CONTACT_EMAIL ? `mailto:${CONTACT_EMAIL}` : undefined);
const usesEmail = !MEMBERSHIP_ENDPOINT && !!CONTACT_EMAIL;
const roles = [
  "Pain specialist or physician",
  "Clinic leader or administrator",
  "Patient or caregiver",
  "Patient advocate or community organization",
  "Health system partner",
];
---

{render && (
  <div
    class:list={["membership-form_wrap", "theme-light", className]}
    {...rest}
  >
    <Heading tag="h3" variant="h4">
      Register your interest
    </Heading>
    <Paragraph variant="small">Be part of the founding membership.</Paragraph>
    {usesEmail && (
      <Paragraph variant="small">
        Submitting opens a draft in your email app. Review it and press Send to
        register your interest.
      </Paragraph>
    )}
    {!action && (
      <p class="membership-form_notice text-style-small">
        Online registration is not open yet. Please check back for membership
        updates.
      </p>
    )}
    <Form
      name="OPSA founding membership"
      variant="default"
      action={action}
      successMessage={
        usesEmail
          ? EMAIL_DRAFT_MESSAGE
          : "Thank you for your interest. Your enquiry has been received."
      }
      errorMessage="Your enquiry could not be sent. Your details are still here; please try again."
      aria-label="Register your interest"
      aria-describedby="membership-privacy"
    >
      <Grid medium={2}>
        <Input
          label="Full name"
          name="name"
          autocomplete="name"
          placeholder="Your full name"
          required
          maxlength={120}
        />
        <Input
          variant="email"
          label="Email"
          name="email"
          placeholder="you@example.ca"
          required
          maxlength={254}
        />
      </Grid>
      <Select label="I am a…" name="role" options={roles} required />
      <Input
        label="Clinic or organization (optional)"
        name="organization"
        autocomplete="organization"
        placeholder="Organization name"
        maxlength={160}
      />
      <Textarea
        label="How would you like to be involved? (optional)"
        name="message"
        placeholder="Tell us a little about your interest in OPSA."
        maxlength={2000}
      />
      <Choice
        label="I agree to be contacted about OPSA membership."
        name="consent"
        value="yes"
        required
      />
      <Button type="submit" disabled={!action}>
        {action
          ? usesEmail
            ? "Continue in email"
            : "Register interest"
          : "Registration opening soon"}
      </Button>
      <Paragraph variant="small" id="membership-privacy">
        Your details are used only to contact you about OPSA membership. Please
        do not include personal medical information.
      </Paragraph>
      <noscript>
        <p>Use the contact details below to enquire about membership.</p>
      </noscript>
    </Form>
  </div>
)}
<style is:global>
  @layer components {
    .membership-form_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      width: 100%;
      padding: var(--space-6);
      border-radius: var(--radius-main);
    }
    .membership-form_notice {
      padding: var(--space-4);
      margin-block: var(--space-5);
      border-inline-start: var(--focus-width) solid var(--brand-500);
      background: var(--background-2);
    }
  }
</style>
